---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'ATAU — 挑戦しやすい社会を創る' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ATAU</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&family=Noto+Sans+JP:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-void text-cream">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!--
      Netlify Identity: 招待・確認メールは多く / に #invite_token 等で着地するためウィジェットを全ページで読み込む。
      login / signup で常に /admin へ飛ばさない（セッション復元でも login が走り、プレビュー iframe や通常閲覧が壊れるため）。
      招待完了後の CMS へはブラウザで /admin/ を開いてもらう。
    -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      (function () {
        if (!window.netlifyIdentity) return;
        window.netlifyIdentity.on('init', function (user) {
          if (user) return;
          var h = window.location.hash || '';
          if (h.indexOf('invite_token') !== -1 || h.indexOf('confirmation_token') !== -1) {
            window.netlifyIdentity.open('signup');
          }
        });
      })();
    </script>
    <script is:inline>
      (function () {
        function setScrollProgress() {
          var root = document.documentElement;
          var scrollable = root.scrollHeight - root.clientHeight;
          var p = scrollable > 0 ? root.scrollTop / scrollable : 1;
          if (p < 0) p = 0;
          if (p > 1) p = 1;
          root.style.setProperty('--scroll-progress', String(p));
        }
        setScrollProgress();
        addEventListener('scroll', setScrollProgress, { passive: true });
        addEventListener('resize', setScrollProgress);
        addEventListener('pageshow', function (e) {
          if (e.persisted) setScrollProgress();
        });
      })();
    </script>
  </body>
</html>
