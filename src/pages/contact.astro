---
import BaseLayout from '../layouts/BaseLayout.astro';
import BaseButton from '../components/BaseButton.astro';
import LayoutContainer from '../components/LayoutContainer.astro';
---

<BaseLayout title="Contact" description="ATAUへのお問い合わせ">

  <!-- Page Header -->
  <section class="pt-40 pb-16">
    <LayoutContainer>
      <p class="font-mono text-xs uppercase tracking-widest text-signal-gold mb-4">Get in Touch</p>
      <h1
        class="font-display font-bold text-cream mb-6"
        style="font-size: clamp(3rem, 8vw, 5rem); letter-spacing: -0.03em; line-height: 1.0;"
      >
        Contact
      </h1>
      <p class="font-body text-dust text-lg max-w-xl leading-relaxed">
        協業・採用・メディアなどのお問い合わせはこちらから。<br />
        2営業日以内にご返答いたします。
      </p>
    </LayoutContainer>
  </section>

  <!-- Form -->
  <section class="border-t py-16" style="border-color: var(--border-subtle);">
    <LayoutContainer>
      <div class="max-w-2xl">
        <!--
          Netlify Forms: data-netlify で検出。
          action は実在するパスへ（未設定の POST は URL によって 404 になりやすい）。
          form-name の value は form の name と完全一致させる（大文字小文字がずれると 404 になることがある）。
        -->
        <form
          name="contact"
          method="POST"
          action="/contact/thanks/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="flex flex-col gap-6"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="flex flex-col gap-2">
            <label for="name" class="font-mono text-xs uppercase tracking-widest text-ash">
              お名前 <span class="text-signal-gold">*</span>
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="w-full px-4 py-3 bg-surface border text-cream font-body text-sm focus:outline-none focus:border-signal-blue transition-colors"
              style="border-color: var(--border-medium); border-radius: var(--radius-md);"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class="font-mono text-xs uppercase tracking-widest text-ash">
              メールアドレス <span class="text-signal-gold">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full px-4 py-3 bg-surface border text-cream font-body text-sm focus:outline-none focus:border-signal-blue transition-colors"
              style="border-color: var(--border-medium); border-radius: var(--radius-md);"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="category" class="font-mono text-xs uppercase tracking-widest text-ash">
              お問い合わせ種別
            </label>
            <select
              id="category"
              name="category"
              class="w-full px-4 py-3 bg-surface border text-cream font-body text-sm focus:outline-none focus:border-signal-blue transition-colors appearance-none cursor-pointer"
              style="border-color: var(--border-medium); border-radius: var(--radius-md);"
            >
              <option value="general">一般的なお問い合わせ</option>
              <option value="business">協業・ビジネス</option>
              <option value="careers">採用</option>
              <option value="media">メディア・取材</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="font-mono text-xs uppercase tracking-widest text-ash">
              メッセージ <span class="text-signal-gold">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="w-full px-4 py-3 bg-surface border text-cream font-body text-sm focus:outline-none focus:border-signal-blue transition-colors resize-none"
              style="border-color: var(--border-medium); border-radius: var(--radius-md);"
            ></textarea>
          </div>

          <div class="flex items-center justify-between pt-2">
            <p class="font-mono text-xs text-ash">* 必須項目</p>
            <BaseButton type="submit" variant="primary" size="sm">
              Send Message
            </BaseButton>
          </div>
        </form>
      </div>
    </LayoutContainer>
  </section>

</BaseLayout>
