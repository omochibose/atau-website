---
import BaseLayout from '../layouts/BaseLayout.astro';
import BaseButton from '../components/BaseButton.astro';
import LayoutContainer from '../components/LayoutContainer.astro';
---

<BaseLayout title="Contact" description="IT・業務改善のご相談、協業・採用・取材のお問い合わせ — ATAU">

  <!-- Page Header -->
  <section class="pt-40 pb-16">
    <LayoutContainer>
      <p class="font-mono text-xs uppercase tracking-widest text-signal-gold mb-4">Get in Touch</p>
      <h1
        class="font-display font-bold text-cream mb-6"
        style="font-size: clamp(3rem, 8vw, 5rem); letter-spacing: -0.03em; line-height: 1.0;"
      >
        Contact
      </h1>
      <p class="font-body text-dust text-lg max-w-xl leading-relaxed">
        IT・業務改善のご相談はもちろん、協業・採用・取材のお問い合わせもこちらから。<br />
        「こんなこと聞いていいのかな」という段階でも歓迎です。2営業日以内にご返答します。
      </p>
    </LayoutContainer>
  </section>

  <!-- LINE alternative -->
  <section class="border-t py-12" style="border-color: var(--border-subtle);">
    <LayoutContainer>
      <div
        class="max-w-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 p-8 border"
        style="border-color: var(--border-subtle); border-radius: var(--radius-lg); background-color: var(--color-depth);"
      >
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-ash mb-2">気軽に話したい方へ</p>
          <p class="font-display font-semibold text-lg text-cream mb-1" style="letter-spacing: -0.01em;">
            まずはLINEで一言どうぞ
          </p>
          <p class="font-body text-dust text-sm leading-relaxed">
            フォームが面倒な方も、LINEならすぐ話せます。
          </p>
        </div>
        <BaseButton
          href="https://lin.ee/XmVPtXM"
          variant="line"
          size="sm"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0"
        >
          <svg class="mr-2 shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 1C5.925 1 1 5.514 1 11.111c0 4.92 3.653 9.037 8.615 9.972l-.395 2.29c-.083.481.488.839.898.554L14.8 20.64C16.3 20.196 17.658 19.46 18.802 18.5 21.302 16.538 23 13.5 23 11.111 23 5.514 18.075 1 12 1z"/>
          </svg>
          LINEを開く
        </BaseButton>
      </div>
    </LayoutContainer>
  </section>

  <!-- Form -->
  <section class="border-t py-16" style="border-color: var(--border-subtle);">
    <LayoutContainer>
      <div class="max-w-2xl">
        <!--
          Netlify Forms: data-netlify で検出。
          action は実在するパスへ（未設定の POST は URL によって 404 になりやすい）。
          form-name の value は form の name と完全一致させる（大文字小文字がずれると 404 になることがある）。
        -->
        <form
          name="contact"
          method="POST"
          action="/contact/thanks/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="flex flex-col gap-6"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="flex flex-col gap-2">
            <label for="name" class="font-mono text-xs uppercase tracking-widest text-ash">
              お名前 <span class="text-signal-gold">*</span>
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="w-full px-4 py-3 bg-surface border text-cream font-body text-sm focus:outline-none focus:border-signal-blue transition-colors"
              style="border-color: var(--border-medium); border-radius: var(--radius-md);"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class="font-mono text-xs uppercase tracking-widest text-ash">
              メールアドレス <span class="text-signal-gold">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full px-4 py-3 bg-surface border text-cream font-body text-sm focus:outline-none focus:border-signal-blue transition-colors"
              style="border-color: var(--border-medium); border-radius: var(--radius-md);"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="category" class="font-mono text-xs uppercase tracking-widest text-ash">
              お問い合わせ種別
            </label>
            <select
              id="category"
              name="category"
              class="w-full px-4 py-3 bg-surface border text-cream font-body text-sm focus:outline-none focus:border-signal-blue transition-colors appearance-none cursor-pointer"
              style="border-color: var(--border-medium); border-radius: var(--radius-md);"
            >
              <option value="it">IT・業務改善のご相談</option>
              <option value="playrecap">PlayRecapに関するご質問・相談</option>
              <option value="business">協業・ビジネス</option>
              <option value="careers">採用</option>
              <option value="media">メディア・取材</option>
              <option value="general">その他</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="font-mono text-xs uppercase tracking-widest text-ash">
              メッセージ <span class="text-signal-gold">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="w-full px-4 py-3 bg-surface border text-cream font-body text-sm focus:outline-none focus:border-signal-blue transition-colors resize-none"
              style="border-color: var(--border-medium); border-radius: var(--radius-md);"
            ></textarea>
          </div>

          <div class="flex items-center justify-between pt-2">
            <p class="font-mono text-xs text-ash">* 必須項目</p>
            <BaseButton type="submit" variant="secondary" size="sm">
              Send Message
            </BaseButton>
          </div>
        </form>
      </div>
    </LayoutContainer>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const prefill = params.get('prefill');
    if (prefill) {
      const messageField = document.querySelector<HTMLTextAreaElement>('[name="message"]');
      if (messageField) messageField.value = prefill;
    }
  </script>

</BaseLayout>
