---
import BaseLayout from '../layouts/BaseLayout.astro';
import LayoutContainer from '../components/LayoutContainer.astro';
import WhatWeOffer from '../components/WhatWeOffer.astro';
import PageCta from '../components/PageCta.astro';
import { mission, pillars } from '../lib/site-messaging';

const pageDescription =
  'Inspire・Amplify・Empowerの3つの柱と、外付けIT・開発・自動化など、ATAUの提供内容をご紹介します。';
---

<BaseLayout title="Business" description={pageDescription}>

  <section class="pt-40 pb-12">
    <LayoutContainer>
      <p class="font-mono text-xs uppercase tracking-widest text-ash mb-4">Why</p>
      <h1
        class="font-display font-bold text-cream mb-6"
        style="font-size: clamp(1.5rem, 8vw, 2rem); letter-spacing: -0.03em; line-height: 1.0;"
      >
        {mission.title}
      </h1>
      <p class="font-body text-dust text-lg max-w-2xl leading-relaxed">
        {mission.lead} そのために、Inspire・Amplify・Empowerの3つの柱を軸に、ITで挑戦を後押しします。
      </p>
    </LayoutContainer>
  </section>

  <WhatWeOffer
    class="bg-depth"
    lead="伴走型のITサービスについて、以下のとおりご紹介します。詳細はブログでも発信しています。"
    showCta={false}
  />

  <section class="border-t py-16" style="border-color: var(--border-subtle);">
    <LayoutContainer class="mb-4 max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-widest text-ash mb-3">How</p>
      <h2 class="font-display font-bold text-4xl text-cream mb-4" style="letter-spacing: -0.02em;">
        Inspire・Amplify・Empower
      </h2>
      <p class="font-body text-dust text-lg leading-relaxed">
        3つの柱はどれも大切にしており、自ら挑戦する（Inspire）、伝える（Amplify）、ITで支える（Empower）という役割を担います。
      </p>
    </LayoutContainer>
  </section>

  {pillars.map((pillar, index) => (
    <section
      class:list={['border-t py-16', index % 2 === 1 && 'bg-depth']}
      style="border-color: var(--border-subtle);"
    >
      <LayoutContainer class="grid md:grid-cols-2 gap-16 items-start">
        <div class:list={[index % 2 === 1 && 'md:order-2']}>
          <p class="font-mono text-xs uppercase tracking-widest text-ash mb-3">{pillar.number}</p>
          <h2 class="font-display font-bold text-5xl text-cream mb-2" style="letter-spacing: -0.02em;">
            {pillar.title}
          </h2>
          <p class="font-mono text-xs uppercase tracking-widest text-dust mb-8">{pillar.subtitle}</p>
          <p class="font-body text-dust text-lg leading-relaxed">{pillar.description}</p>
        </div>
        <div
          class:list={[
            'p-8 border',
            index % 2 === 1 && 'md:order-1',
          ]}
          style="border-color: var(--border-subtle); border-radius: var(--radius-lg); background-color: var(--color-surface);"
        >
          <p class="font-mono text-xs text-ash uppercase tracking-widest mb-4">{pillar.detailLabel}</p>
          <p class="font-body text-dust leading-relaxed">{pillar.detail}</p>
        </div>
      </LayoutContainer>
    </section>
  ))}

  <PageCta class="bg-depth" />

</BaseLayout>
