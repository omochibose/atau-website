---
import BaseLayout from '../layouts/BaseLayout.astro';
import LayoutContainer from '../components/LayoutContainer.astro';
---

<BaseLayout title="Business" description="ATAUの事業領域 — Inspire, Amplify, Empower">

  <!-- Page Header -->
  <section class="pt-40 pb-16">
    <LayoutContainer>
      <p class="font-mono text-xs uppercase tracking-widest text-ash mb-4">Business</p>
      <h1
        class="font-display font-bold text-cream mb-6"
        style="font-size: clamp(1.5rem, 8vw, 2rem); letter-spacing: -0.03em; line-height: 1.0;"
      >
        挑戦を連鎖させる３つの事業
      </h1>
      <p class="font-body text-dust text-lg max-w-2xl leading-relaxed">
        ATAUは「Inspire」を上位概念として、「Amplify」と「Empower」をその手段として事業を展開しています。
      </p>
    </LayoutContainer>
  </section>

  <!-- 01 Inspire -->
  <section class="border-t py-16" style="border-color: var(--border-subtle);">
    <LayoutContainer class="grid md:grid-cols-2 gap-16 items-start">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-ash mb-3">01</p>
        <h2 class="font-display font-bold text-5xl text-cream mb-2" style="letter-spacing: -0.02em;">
          Inspire
        </h2>
        <p class="font-mono text-xs uppercase tracking-widest text-dust mb-8">挑戦を生み出す</p>
        <p class="font-body text-dust text-lg leading-relaxed">
          ATAUが率先して高い目標に挑戦することで、他者の挑戦の火を灯す。自社の挑戦そのものがプロダクトであり、メッセージである。
        </p>
      </div>
      <div
        class="p-8 border"
        style="border-color: var(--border-subtle); border-radius: var(--radius-lg); background-color: #1A1810;"
      >
        <p class="font-mono text-xs text-ash uppercase tracking-widest mb-4">Concept</p>
        <p class="font-body text-dust leading-relaxed">
          私たち自身が高い目標に挑戦し続けることで、「やればできる」という前例を社会に示す。自社の存在と活動そのものが、他者への勇気となる。
        </p>
      </div>
    </LayoutContainer>
  </section>

  <!-- 02 Amplify -->
  <section class="border-t bg-depth py-16" style="border-color: var(--border-subtle);">
    <LayoutContainer class="grid md:grid-cols-2 gap-16 items-start">
      <div class="md:order-2">
        <p class="font-mono text-xs uppercase tracking-widest text-ash mb-3">02</p>
        <h2 class="font-display font-bold text-5xl text-cream mb-2" style="letter-spacing: -0.02em;">
          Amplify
        </h2>
        <p class="font-mono text-xs uppercase tracking-widest text-dust mb-8">挑戦を広める</p>
        <p class="font-body text-dust text-lg leading-relaxed">
          自社および他者の挑戦のプロセスと成果を広報・発信することで、前例を社会に蓄積する。前例は次の挑戦者の勇気になる。
        </p>
      </div>
      <div
        class="md:order-1 p-8 border"
        style="border-color: var(--border-subtle); border-radius: var(--radius-lg); background-color: #1A1810;"
      >
        <p class="font-mono text-xs text-ash uppercase tracking-widest mb-4">Concept</p>
        <p class="font-body text-dust leading-relaxed">
          挑戦のプロセスを可視化し発信することで、社会全体の「挑戦の前例」を増やす。一つの成功が、次の千の挑戦を生む。
        </p>
      </div>
    </LayoutContainer>
  </section>

  <!-- 03 Empower -->
  <section class="border-t py-16" style="border-color: var(--border-subtle);">
    <LayoutContainer class="grid md:grid-cols-2 gap-16 items-start">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-ash mb-3">03</p>
        <h2 class="font-display font-bold text-5xl text-cream mb-2" style="letter-spacing: -0.02em;">
          Empower
        </h2>
        <p class="font-mono text-xs uppercase tracking-widest text-dust mb-8">挑戦を後押しする</p>
        <p class="font-body text-dust text-lg leading-relaxed">
          挑戦の過程で獲得した知見をサービス・プロダクトとして昇華し、他者の挑戦を実質的に支援する。
        </p>
      </div>
      <div
        class="p-8 border"
        style="border-color: var(--border-subtle); border-radius: var(--radius-lg); background-color: #1A1810;"
      >
        <p class="font-mono text-xs text-ash uppercase tracking-widest mb-4">Concept</p>
        <p class="font-body text-dust leading-relaxed">
          ATAUの経験から生まれたサービスやツールで、挑戦者の壁を取り除く。知見を製品化し、より多くの挑戦を実質的に支える仕組みを作る。
        </p>
      </div>
    </LayoutContainer>
  </section>

</BaseLayout>
