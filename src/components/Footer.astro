---
import LayoutContainer from './LayoutContainer.astro';

const year = new Date().getFullYear();
---

<footer class="border-t mt-24" style="border-color: var(--border-subtle);">
  <LayoutContainer class="py-16">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12">
      <!-- Brand -->
      <div>
        <p class="font-display font-bold text-2xl text-cream mb-2" style="letter-spacing: -0.03em;">ATAU</p>
        <p class="font-mono text-xs text-ash uppercase tracking-widest">Inspire Ambition</p>
      </div>

      <!-- Navigation -->
      <nav class="flex flex-col gap-2">
        <p class="font-mono text-xs text-ember uppercase tracking-widest mb-2">Navigation</p>
        <a href="/about"    class="font-mono text-xs text-dust hover:text-cream transition-colors">About</a>
        <a href="/business" class="font-mono text-xs text-dust hover:text-cream transition-colors">Business</a>
        <a href="/blog"     class="font-mono text-xs text-dust hover:text-cream transition-colors">Blog</a>
        <a href="/contact"  class="font-mono text-xs text-dust hover:text-cream transition-colors">Contact</a>
        <a href="/privacy"  class="font-mono text-xs text-dust hover:text-cream transition-colors">Privacy Policy</a>
      </nav>

      <!-- Business -->
      <div class="flex flex-col gap-2">
        <p class="font-mono text-xs text-ember uppercase tracking-widest mb-2">Business</p>
        <span class="font-mono text-xs text-dust">Inspire — 生み出す</span>
        <span class="font-mono text-xs text-dust">Amplify — 広める</span>
        <span class="font-mono text-xs text-dust">Empower — 後押しする</span>
      </div>
    </div>

    <div
      class="mt-12 pt-6 flex flex-col md:flex-row justify-between items-center gap-4 border-t"
      style="border-color: var(--border-subtle);"
    >
      <p class="font-mono text-xs text-ash">© {year} ATAU. All rights reserved.</p>
      <p class="font-mono text-xs text-ash">挑戦しやすい社会を創る</p>
    </div>
  </LayoutContainer>
</footer>
