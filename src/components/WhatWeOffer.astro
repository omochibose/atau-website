---
import BaseButton from './BaseButton.astro';
import LayoutContainer from '../components/LayoutContainer.astro';
import { consultationTopics, empowerOffer, empowerOfferings } from '../lib/site-messaging';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  id="offerings"
  class:list={['border-t py-16', className]}
  style="border-color: var(--border-subtle);"
>
  <LayoutContainer>
    <div class="mb-10 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-widest text-signal-blue mb-3">{empowerOffer.label}</p>
      <h2 class="font-display font-bold text-4xl text-cream mb-4" style="letter-spacing: -0.02em;">
        {empowerOffer.heading}
      </h2>
      <p class="font-body text-dust text-lg leading-relaxed">{empowerOffer.lead}</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 mb-10">
      {empowerOfferings.map((item) => (
        <a
          href={item.href}
          class="block p-6 border group hover:border-signal-blue transition-colors duration-200"
          style="border-color: var(--border-subtle); border-radius: var(--radius-lg); background-color: var(--color-surface);"
          {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <h3
            class="font-display font-semibold text-xl text-cream group-hover:text-signal-blue transition-colors mb-1"
            style="letter-spacing: -0.01em;"
          >
            {item.title}
          </h3>
          {item.subtitle && (
            <p class="font-mono text-xs text-ash uppercase tracking-widest mb-3">{item.subtitle}</p>
          )}
          <p class="font-body text-dust text-sm leading-relaxed">{item.description}</p>
          <p class="font-mono text-xs text-ash uppercase tracking-widest mt-4 group-hover:text-signal-blue transition-colors">
            {item.external ? 'サービスサイトへ →' : '詳しく読む →'}
          </p>
        </a>
      ))}
    </div>

    <div
      class="p-8 border"
      style="border-color: var(--border-subtle); border-radius: var(--radius-lg);"
    >
      <p class="font-mono text-xs uppercase tracking-widest text-ash mb-4">こんなご相談を歓迎します</p>
      <ul class="grid sm:grid-cols-2 gap-3 mb-6">
        {consultationTopics.map((topic) => (
          <li class="font-body text-dust text-sm leading-relaxed flex gap-2">
            <span class="text-signal-blue shrink-0" aria-hidden="true">—</span>
            <span>{topic}</span>
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap items-center gap-4">
        <BaseButton href="/contact" variant="secondary" size="sm">
          ITのご相談
        </BaseButton>
        <a
          href={empowerOffer.detailHref}
          class="font-mono text-xs uppercase tracking-widest text-signal-blue hover:opacity-70 transition-opacity"
        >
          {empowerOffer.detailLabel} →
        </a>
      </div>
    </div>
  </LayoutContainer>
</section>
