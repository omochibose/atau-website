---
/**
 * サイト全体の水平リズム。max-width は --page-max、左右余白はブレークポイントで増やす。
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full max-w-[var(--page-max)] px-6 sm:px-8 md:px-14 lg:px-20 xl:px-24',
    className,
  ]}
>
  <slot />
</div>
