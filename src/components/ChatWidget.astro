---
// 全ページ共通のフローティングチャットウィジェット。マークアップのみで、
// ロジックは同ファイル内のscriptタグに実装（フレームワーク不使用）。
// z-indexはHeader(z-50)・左端スクロールインジケーター(z-59/60)より上に出す。
---

<div id="chat-widget-root" class="fixed bottom-6 right-6 z-[70] flex flex-col items-end gap-3">
  <div
    id="chat-panel"
    role="dialog"
    aria-label="AIチャットボット"
    aria-hidden="true"
    class="hidden w-[calc(100vw-2rem)] sm:w-96 border flex flex-col"
    style="border-color: var(--border-subtle); border-radius: var(--radius-lg); background-color: var(--color-depth); box-shadow: 0 8px 30px rgba(26, 24, 20, 0.16);"
  >
    <div class="flex items-start justify-between px-6 pt-6 pb-2">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-ash mb-2">Ask ATAU</p>
        <p class="font-body text-dust text-sm leading-relaxed">
          サイトの内容をもとに、AIが自動でお答えします。回答は根拠がある場合のみ表示されます。
        </p>
      </div>
      <button
        type="button"
        id="chat-close"
        aria-label="閉じる"
        class="shrink-0 -mt-1 -mr-2 p-2 text-ash hover:text-cream transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div
      id="chat-messages"
      role="log"
      aria-live="polite"
      class="flex flex-col gap-3 px-6 py-4 max-h-96 overflow-y-auto"
    ></div>

    <form id="chat-form" class="flex items-center gap-3 px-6 pb-6 pt-2">
      <input
        type="text"
        id="chat-input"
        maxlength="500"
        required
        placeholder="質問を入力してください"
        autocomplete="off"
        class="flex-1 min-w-0 px-4 py-3 bg-surface border text-cream font-body text-sm focus:outline-none focus:border-signal-blue transition-colors"
        style="border-color: var(--border-medium); border-radius: var(--radius-md);"
      />
      <button
        type="submit"
        id="chat-submit"
        class="shrink-0 px-6 py-3 bg-signal-blue text-white font-mono text-xs uppercase tracking-widest hover:opacity-90 transition-opacity disabled:opacity-50 disabled:pointer-events-none"
        style="border-radius: var(--radius-md);"
      >
        送信
      </button>
    </form>
  </div>

  <button
    type="button"
    id="chat-toggle"
    aria-expanded="false"
    aria-controls="chat-panel"
    class="flex items-center gap-2 px-5 py-4 bg-signal-blue text-white font-mono text-xs uppercase tracking-widest hover:opacity-90 transition-opacity"
    style="border-radius: var(--radius-full); box-shadow: 0 8px 24px rgba(26, 24, 20, 0.2);"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path
        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span class="hidden sm:inline">AIボットに質問する</span>
    <span class="sm:hidden">AIに質問</span>
  </button>
</div>

<script>
  type Message = {
    role: 'user' | 'assistant';
    content: string;
    sources?: { title: string; url: string }[];
    noMatch?: boolean;
    clarify?: boolean;
    clarifySlugs?: string[];
    isError?: boolean;
  };

  const state: { messages: Message[]; isLoading: boolean; isOpen: boolean } = {
    messages: [],
    isLoading: false,
    isOpen: false,
  };

  const root = document.querySelector<HTMLDivElement>('#chat-widget-root')!;
  const panel = document.querySelector<HTMLDivElement>('#chat-panel')!;
  const toggleButton = document.querySelector<HTMLButtonElement>('#chat-toggle')!;
  const closeButton = document.querySelector<HTMLButtonElement>('#chat-close')!;
  const form = document.querySelector<HTMLFormElement>('#chat-form')!;
  const input = document.querySelector<HTMLInputElement>('#chat-input')!;
  const submitButton = document.querySelector<HTMLButtonElement>('#chat-submit')!;
  const messagesEl = document.querySelector<HTMLDivElement>('#chat-messages')!;

  const FALLBACK_MESSAGE =
    '一時的に応答できません。お手数ですがお問い合わせフォームをご利用ください。';

  function escapeHtml(s: string): string {
    const div = document.createElement('div');
    div.textContent = s;
    return div.innerHTML;
  }

  function lastUserQuestion(): string {
    return (
      [...state.messages].reverse().find((m) => m.role === 'user')?.content ?? ''
    );
  }

  function renderMessage(m: Message): string {
    if (m.role === 'user') {
      return `<div class="self-end max-w-[85%] px-4 py-2 text-sm font-body text-cream" style="background-color: var(--color-surface); border-radius: var(--radius-md);">${escapeHtml(m.content)}</div>`;
    }

    if (m.noMatch) {
      const prefillUrl = `/contact/?prefill=${encodeURIComponent(lastUserQuestion())}`;
      return `
        <div class="self-start max-w-[85%] px-4 py-2 text-sm font-body text-dust leading-relaxed" style="background-color: var(--color-surface); border-radius: var(--radius-md);">
          ご質問ありがとうございます。恐れ入りますが、サイト内には該当する情報が見つかりませんでした。担当者が直接お答えしますので、よろしければ以下からお問い合わせください。
          <a href="${escapeHtml(prefillUrl)}" class="text-signal-blue underline underline-offset-2">お問い合わせフォームへ</a>
        </div>`;
    }

    const sourcesHtml = m.sources?.length
      ? `<ul class="mt-2 flex flex-col gap-1">${m.sources
          .map(
            (s) =>
              `<li><a href="${escapeHtml(s.url)}" class="text-signal-blue text-xs underline underline-offset-2">${escapeHtml(s.title)}</a></li>`
          )
          .join('')}</ul>`
      : '';

    const textColor = m.isError ? 'text-dust' : 'text-cream';

    return `<div class="self-start max-w-[85%] px-4 py-2 text-sm font-body ${textColor}" style="background-color: var(--color-surface); border-radius: var(--radius-md);">${escapeHtml(m.content)}${sourcesHtml}</div>`;
  }

  function render() {
    messagesEl.innerHTML = state.messages.map(renderMessage).join('');
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function setLoading(isLoading: boolean) {
    state.isLoading = isLoading;
    submitButton.disabled = isLoading;
    submitButton.textContent = isLoading ? '送信中…' : '送信';
  }

  function openPanel() {
    state.isOpen = true;
    panel.classList.remove('hidden');
    panel.setAttribute('aria-hidden', 'false');
    toggleButton.setAttribute('aria-expanded', 'true');
    input.focus();
  }

  function closePanel() {
    state.isOpen = false;
    panel.classList.add('hidden');
    panel.setAttribute('aria-hidden', 'true');
    toggleButton.setAttribute('aria-expanded', 'false');
    toggleButton.focus();
  }

  toggleButton.addEventListener('click', () => {
    if (state.isOpen) {
      closePanel();
    } else {
      openPanel();
    }
  });

  closeButton.addEventListener('click', closePanel);

  root.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && state.isOpen) {
      closePanel();
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = input.value.trim();
    if (!question || state.isLoading) return;

    const history = state.messages.map((m) => ({
      role: m.role,
      content: m.content,
      clarify: m.clarify,
      clarifySlugs: m.clarifySlugs,
    }));

    state.messages.push({ role: 'user', content: question });
    input.value = '';
    setLoading(true);
    render();

    try {
      const res = await fetch('/.netlify/functions/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, history }),
      });
      const data = await res.json();

      if (!res.ok || data.error) {
        state.messages.push({ role: 'assistant', content: FALLBACK_MESSAGE, isError: true });
      } else if (data.clarify) {
        state.messages.push({
          role: 'assistant',
          content: data.clarifyQuestion ?? '',
          clarify: true,
          clarifySlugs: data.clarifySlugs,
        });
      } else if (data.noMatch) {
        state.messages.push({ role: 'assistant', content: '', noMatch: true });
      } else {
        state.messages.push({
          role: 'assistant',
          content: data.answer,
          sources: data.sources,
        });
      }
    } catch {
      state.messages.push({ role: 'assistant', content: FALLBACK_MESSAGE, isError: true });
    } finally {
      setLoading(false);
      render();
    }
  });
</script>
