---
import BaseButton from './BaseButton.astro';
import LayoutContainer from './LayoutContainer.astro';

const navLinks = [
  { href: '/',          label: 'Home',    sub: 'ホーム'   },
  { href: '/about',    label: 'About',   sub: '会社情報' },
  { href: '/business', label: 'Offers',  sub: '提供内容' },
  { href: '/blog',     label: 'Blog',    sub: 'ブログ'   },
  { href: '/contact',  label: 'Contact', sub: 'お問い合わせ' },
];

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b"
  style="border-color: var(--border-subtle); background-color: color-mix(in srgb, var(--color-void) 92%, transparent); backdrop-filter: blur(12px);"
>
  {/*
    peer / peer-checked は同一親の後続兄弟にしか効かない。
    チェックボックスは header 直下の先頭に置き、モバイルパネルをその後続兄弟にする。
  */}
  <input
    type="checkbox"
    id="menu-toggle"
    class="peer sr-only"
    aria-controls="site-mobile-nav"
    autocomplete="off"
  />
  <LayoutContainer class="flex h-16 items-center justify-between">
    <!-- Logo -->
    <a
      href="/"
      class="font-display font-bold text-xl text-cream tracking-tight"
      style="letter-spacing: -0.03em;"
    >
      ATAU
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`flex flex-col items-center gap-0.5 transition-colors duration-200 ${isActive ? 'text-signal-blue' : 'text-dust hover:text-cream'}`}
          >
            <span class="font-mono text-xs uppercase tracking-widest">{link.label}</span>
            <span class="font-body text-[10px] tracking-normal normal-case opacity-70">{link.sub}</span>
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA（Gold：補助の行動導線） -->
    <BaseButton href="/contact" variant="secondary" size="sm" class="hidden md:inline-flex">
      ご相談
    </BaseButton>

    <!-- Mobile Menu Toggle（input は header 先頭の peer と id で連動） -->
    <label
      for="menu-toggle"
      class="md:hidden cursor-pointer text-dust hover:text-cream transition-colors p-1"
      aria-label="メニューを開く"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
        <line x1="2" y1="5"  x2="20" y2="5"  />
        <line x1="2" y1="11" x2="20" y2="11" />
        <line x1="2" y1="17" x2="20" y2="17" />
      </svg>
    </label>
  </LayoutContainer>

  <!-- Mobile Nav -->
  <div
    id="site-mobile-nav"
    class="hidden peer-checked:block md:hidden border-t"
    style="border-color: var(--border-subtle); background-color: color-mix(in srgb, var(--color-void) 97%, transparent);"
  >
    <LayoutContainer class="py-4">
      <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="flex items-baseline gap-2 text-dust hover:text-cream transition-colors py-3 border-b"
            style="border-color: var(--border-subtle);"
          >
            <span class="font-mono text-xs uppercase tracking-widest">{link.label}</span>
            <span class="font-body text-[10px] opacity-60">{link.sub}</span>
          </a>
        ))}
        <BaseButton href="/contact" variant="secondary" size="sm" class="md:hidden w-full justify-center mt-3 py-3">
          ご相談
        </BaseButton>
      </nav>
    </LayoutContainer>
  </div>
</header>
