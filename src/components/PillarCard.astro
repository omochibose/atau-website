---
interface Props {
  number: string;
  title: string;
  subtitle: string;
  description: string;
}

const { number, title, subtitle, description } = Astro.props;
---

<div
  class="p-8 border"
  style="border-color: var(--border-subtle); border-radius: var(--radius-lg); background-color: #1A1810;"
>
  <p class="font-mono text-xs uppercase tracking-widest text-ash mb-4">{number}</p>
  <h3
    class="font-display font-semibold text-2xl text-cream mb-1"
    style="letter-spacing: -0.01em;"
  >
    {title}
  </h3>
  <p class="font-mono text-xs uppercase tracking-widest text-dust mb-6">{subtitle}</p>
  <p class="font-body text-dust text-sm leading-relaxed">{description}</p>
</div>
